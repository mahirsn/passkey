#!/usr/bin/env python3
"""Plugs the passkey app on an Android device into this computer as a FIDO2
security key.

While the device is connected (USB through adb, or Bluetooth) a virtual FIDO
HID device exists via /dev/uhid, so libfido2, pam_u2f and browsers treat it
like a plugged-in key. CTAPHID packets are assembled here; only CTAP2
requests go to the device, where the fingerprint is asked. When the device is
away there is no key at all, so PAM moves on to the password immediately.
"""
import itertools, os, pwd, queue, random, re, select, shutil, socket, struct, subprocess, threading, time

REQ, CANCEL, PING, RESP, PONG = 0x10, 0x11, 0x12, 0x20, 0x22
BT_UUID = "7a1b6b65-7900-4e6f-9d2a-6d6168697273"
BT_CHANNEL = 27
SDP_RECORD = f"""<?xml version="1.0" encoding="UTF-8" ?>
<record>
  <attribute id="0x0001"><sequence><uuid value="{BT_UUID}" /></sequence></attribute>
  <attribute id="0x0004"><sequence>
    <sequence><uuid value="0x0100" /></sequence>
    <sequence><uuid value="0x0003" /><uint8 value="0x{BT_CHANNEL:02x}" /></sequence>
  </sequence></attribute>
  <attribute id="0x0005"><sequence><uuid value="0x1002" /></sequence></attribute>
  <attribute id="0x0100"><text value="passkey" /></attribute>
</record>"""
ADB_USER = os.environ.get("PASSKEY_ADB_USER", "")
SOCKET = os.environ.get("PASSKEY_SOCKET", "passkey")   # "passkey.test" reaches test builds
VERBOSE = os.environ.get("PASSKEY_DEBUG", "1") == "1"   # one short line per request
# Shared with `passkey add`: "devices" lists the connected devices (id TAB
# label), "use" (id SPACE pid) sends every request to one of them while that
# process lives. A device's id is its Bluetooth address, so its USB and
# Bluetooth connections count as one device.
STATE = os.environ.get("PASSKEY_STATE", "/run/passkey")


def log(*a):
    print(*a, flush=True)


# --- connection to the device -------------------------------------------------
class Link:
    """One device connection. Frame: 4-byte length + body; REQ/RESP/CANCEL
    carry a 4-byte request number after the type byte."""

    def __init__(self, name, sock, prio, label="", device=None):
        self.name, self.sock, self.prio = name, sock, prio
        self.device = device or name
        self.label = " ".join(label.split())   # no tabs or newlines in the list
        self.responses = queue.Queue()          # (request number, payload) or None
        self.alive = True
        self.pong = threading.Event()
        self.wlock = threading.Lock()

    def send(self, body):
        with self.wlock:
            self.sock.sendall(struct.pack(">I", len(body)) + body)

    def _read(self, n):
        b = b""
        while len(b) < n:
            c = self.sock.recv(n - len(b))
            if not c:
                raise ConnectionError("closed")
            b += c
        return b

    def run(self, on_close):
        try:
            while True:
                n = struct.unpack(">I", self._read(4))[0]
                if not 1 <= n <= 8192:
                    raise ConnectionError(f"frame length {n}")
                body = self._read(n)
                if body[0] == RESP and n >= 5:
                    self.responses.put((struct.unpack_from(">I", body, 1)[0], body[5:]))
                elif body[0] == PONG:
                    self.pong.set()
        except (OSError, ConnectionError) as e:
            if VERBOSE:
                log(self.name, "read ended:", e)
        finally:
            self.close()
            on_close(self)

    def ping(self, timeout):
        self.pong.clear()
        try:
            self.send(bytes([PING]))
        except OSError:
            return False
        return self.pong.wait(timeout)

    def close(self):
        self.alive = False
        self.responses.put(None)
        try:
            self.sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        self.sock.close()


def chosen_device():
    # ponytail: a pid reused after `passkey add` was SIGKILLed keeps the choice
    # alive; compare /proc/<pid>/stat start times if that ever matters.
    try:
        with open(STATE + "/use") as f:
            name, pid = f.read().split()
        pid = int(pid)
    except (OSError, ValueError):
        return None
    return name if os.path.exists(f"/proc/{pid}") else None


class Links:
    def __init__(self, on_change):
        self.lock = threading.Lock()
        self.items = []
        self.on_change = on_change

    def add(self, link):
        with self.lock:
            self.items.append(link)
            self._publish()
        log("connected:", link.name, link.label, "device " + link.device)
        threading.Thread(target=link.run, args=(self.remove,), daemon=True).start()
        self.on_change()

    def remove(self, link):
        with self.lock:
            if link not in self.items:
                return
            self.items.remove(link)
            self._publish()
        log("disconnected:", link.name)
        self.on_change()

    def _publish(self):
        try:
            os.makedirs(STATE, exist_ok=True)
            labels = {}
            for l in sorted(self.items, key=lambda l: l.prio):
                if not labels.get(l.device):
                    labels[l.device] = l.label
            with open(STATE + "/devices.new", "w") as f:
                f.writelines(f"{d}\t{label}\n" for d, label in labels.items())
            os.replace(STATE + "/devices.new", STATE + "/devices")
        except OSError as e:
            log("state:", e)

    def by_device(self):
        """One connection per device, USB before Bluetooth (less delay), then
        the oldest; devices in that same order."""
        with self.lock:
            live = [l for l in self.items if l.alive]
        out = {}
        for l in sorted(live, key=lambda l: l.prio):
            out.setdefault(l.device, l)
        return out

    def any(self):
        with self.lock:
            return any(l.alive for l in self.items)

    def names(self):
        with self.lock:
            return {l.name for l in self.items}

    def all(self):
        with self.lock:
            return list(self.items)


# --- uhid ---------------------------------------------------------------------
UHID_DESTROY, UHID_CLOSE, UHID_OUTPUT, UHID_GET_REPORT, UHID_GET_REPORT_REPLY = 1, 5, 6, 9, 10
UHID_CREATE2, UHID_INPUT2, UHID_SET_REPORT, UHID_SET_REPORT_REPLY = 11, 12, 13, 14
EVENT_SIZE = 4 + 4372
# FIDO HID: 64-byte input and output reports, no report ids.
REPORT_DESC = bytes.fromhex(
    "06d0f1" "0901" "a101"
    "0920" "1500" "26ff00" "7508" "9540" "8102"
    "0921" "1500" "26ff00" "7508" "9540" "9102"
    "c0")


class Uhid:
    def __init__(self, on_report, on_close):
        self.fd = None
        self.lock = threading.Lock()
        self.on_report, self.on_close = on_report, on_close

    def create(self):
        with self.lock:
            if self.fd is not None:
                return
            fd = os.open("/dev/uhid", os.O_RDWR | os.O_CLOEXEC)
            ev = struct.pack("<I128s64s64sHHIIII", UHID_CREATE2, b"passkey", b"passkey", b"",
                             len(REPORT_DESC), 0x03, 0x1209, 0x7AB1, 1, 0)
            os.write(fd, (ev + REPORT_DESC).ljust(EVENT_SIZE, b"\0"))
            self.fd = fd
        threading.Thread(target=self._read, args=(fd,), daemon=True).start()
        log("FIDO device added")

    def destroy(self):
        # Only the reader closes the fd: closing it here could hand the same
        # number to a new socket while the reader is still reading it.
        with self.lock:
            fd, self.fd = self.fd, None
            if fd is None:
                return
            os.write(fd, struct.pack("<I", UHID_DESTROY).ljust(EVENT_SIZE, b"\0"))
        log("FIDO device removed")

    def send(self, report):
        with self.lock:
            if self.fd is None:
                return
            os.write(self.fd, struct.pack("<IH", UHID_INPUT2, 64) + report.ljust(64, b"\0"))

    def _read(self, fd):
        try:
            while self.fd == fd:
                if not select.select([fd], [], [], 0.5)[0]:
                    continue
                ev = os.read(fd, EVENT_SIZE + 16)
                if len(ev) < 4:
                    return
                t = struct.unpack_from("<I", ev)[0]
                if t == UHID_OUTPUT:
                    size, = struct.unpack_from("<H", ev, 4 + 4096)
                    pkt = ev[4:4 + size]
                    if size == 65:          # report number hidraw puts in front
                        pkt = pkt[1:]
                    try:
                        self.on_report(pkt[:64])
                    except Exception as e:  # a bad packet must not end the reader
                        log("packet dropped:", e)
                elif t == UHID_CLOSE:       # the last reader closed the hidraw node
                    self.on_close()
                elif t in (UHID_GET_REPORT, UHID_SET_REPORT):
                    rid, = struct.unpack_from("<I", ev, 4)
                    reply = UHID_GET_REPORT_REPLY if t == UHID_GET_REPORT else UHID_SET_REPORT_REPLY
                    with self.lock:
                        if self.fd == fd:
                            os.write(fd, struct.pack("<IIHH", reply, rid, 5, 0).ljust(EVENT_SIZE, b"\0"))
        except OSError:
            pass
        finally:
            with self.lock:
                if self.fd == fd:           # died on its own: let create() start over
                    self.fd = None
            os.close(fd)


# --- CTAPHID ------------------------------------------------------------------
PING_CMD, MSG, INIT, WINK, CBOR, CANCEL_CMD, KEEPALIVE, ERROR = 0x81, 0x83, 0x86, 0x88, 0x90, 0x91, 0xBB, 0xBF
ERR_INVALID_CMD, ERR_INVALID_LEN, ERR_INVALID_SEQ, ERR_CHANNEL_BUSY, ERR_INVALID_CHANNEL = 0x01, 0x03, 0x04, 0x06, 0x0B
CTAP2_ERR_OTHER = 0x7F
MAKE_CREDENTIAL, GET_ASSERTION, GET_INFO, GET_NEXT_ASSERTION = 0x01, 0x02, 0x04, 0x08
OPERATION_DENIED, NO_CREDENTIALS = 0x27, 0x2E


def cbor(b, i=0):
    """One CBOR item at b[i]: (value, index after it)."""
    major, info = b[i] >> 5, b[i] & 31
    i += 1
    if info < 24:
        n = info
    elif info < 28:
        k = 1 << (info - 24)
        n, i = int.from_bytes(b[i:i + k], "big"), i + k
    else:
        raise ValueError("indefinite length")
    if major == 0:
        return n, i
    if major == 1:
        return -1 - n, i
    if major in (2, 3):
        if len(b) < i + n:
            raise ValueError("short")
        return (b[i:i + n] if major == 2 else b[i:i + n].decode()), i + n
    if major == 4:
        out = []
        for _ in range(n):
            v, i = cbor(b, i)
            out.append(v)
        return out, i
    if major == 5:
        out = {}
        for _ in range(n):
            k, i = cbor(b, i)
            out[k], i = cbor(b, i)
        return out, i
    if major == 6:                   # a tag: the item it wraps
        return cbor(b, i)
    return {20: False, 21: True}.get(info), i


def silent(data):
    """A getAssertion that only asks which device holds the key (up=false):
    pam_u2f sends one before the real request. The app answers it without
    asking the user."""
    try:
        m = cbor(data, 1)[0]
        return data[0] == GET_ASSERTION and m.get(5, {}).get("up") is False
    except Exception:
        return False


class Request:
    def __init__(self, cid, number):
        self.cid, self.number = cid, number
        self.pending = []            # connections still asked
BROADCAST = 0xFFFFFFFF


class Ctaphid:
    def __init__(self, links):
        self.uhid, self.links = None, links
        self.partial = {}            # cid -> [cmd, total, data, next seq]
        self.lock = threading.Lock()
        self.busy = None             # the Request in flight
        self.numbers = itertools.count(1)
        self.holders = set()         # devices that said they hold the key
        self.last = None             # device of the last approval (getNextAssertion)

    def reply(self, cid, cmd, data):
        head = struct.pack(">IBH", cid, cmd, len(data))
        self.uhid.send(head + data[:57])
        rest, seq = data[57:], 0
        while rest:
            self.uhid.send(struct.pack(">IB", cid, seq) + rest[:59])
            rest, seq = rest[59:], seq + 1

    def error(self, cid, code):
        self.reply(cid, ERROR, bytes([code]))

    def cancel(self, cid=None, abandon=False):
        """Withdraw the request in flight (only that of `cid`, if given).
        abandon: the channel was reset; nothing more is sent on it for this request."""
        with self.lock:
            busy = self.busy
            if busy and abandon and busy.cid == cid:
                self.busy = None
            pending = list(busy.pending) if busy else []
        if busy and (cid is None or busy.cid == cid):
            self._withdraw(busy, pending)

    @staticmethod
    def _withdraw(req, links):
        for l in links:
            try:
                l.send(struct.pack(">BI", CANCEL, req.number))
            except OSError:
                pass

    def packet(self, pkt):
        if len(pkt) < 5:
            return
        cid, b = struct.unpack_from(">IB", pkt)
        if b & 0x80:                       # initialization packet
            if len(pkt) < 7:
                return
            n, = struct.unpack_from(">H", pkt, 5)
            if n > 7609:
                return self.error(cid, ERR_INVALID_LEN)
            if b == CANCEL_CMD:
                return self.cancel(cid)
            busy = self.busy
            if b == INIT:
                self.partial.pop(cid, None)
                self.cancel(cid, abandon=True)   # INIT on a busy channel aborts it
            elif busy is not None and busy.cid != cid:
                return self.error(cid, ERR_CHANNEL_BUSY)
            self.partial[cid] = [b, n, bytearray(pkt[7:7 + n]), 0]
        else:                              # continuation packet
            p = self.partial.get(cid)
            if not p:
                return
            if b != p[3]:
                self.partial.pop(cid, None)
                return self.error(cid, ERR_INVALID_SEQ)
            p[2] += pkt[5:5 + p[1] - len(p[2])]
            p[3] += 1
        p = self.partial[cid]
        if len(p[2]) < p[1]:
            return
        del self.partial[cid]
        self.dispatch(cid, p[0], bytes(p[2]))

    def dispatch(self, cid, cmd, data):
        if cmd == INIT:
            if len(data) != 8:
                return self.error(cid, ERR_INVALID_LEN)
            new = random.randint(1, 0xFFFFFFFE) if cid == BROADCAST else cid
            # protocol 2, device 1.0.0, capabilities WINK | CBOR | NMSG (no U2F)
            return self.reply(cid, INIT, data + struct.pack(">IBBBBB", new, 2, 1, 0, 0, 0x01 | 0x04 | 0x08))
        if cid in (BROADCAST, 0):
            return self.error(cid, ERR_INVALID_CHANNEL)
        if cmd == PING_CMD:
            return self.reply(cid, PING_CMD, data)
        if cmd == WINK:
            return self.reply(cid, WINK, b"")
        if cmd != CBOR:
            return self.error(cid, ERR_INVALID_CMD)
        if not data or not self.links.any():
            return self.reply(cid, CBOR, bytes([CTAP2_ERR_OTHER]))
        with self.lock:
            if self.busy is not None:
                return self.error(cid, ERR_CHANNEL_BUSY)
            me = self.busy = Request(cid, next(self.numbers))
        threading.Thread(target=self._cbor, args=(me, data), daemon=True).start()

    def _cbor(self, me, data):
        def answer(cmd, payload):          # silent once the channel was reset
            if self.busy is me:
                self.reply(me.cid, cmd, payload)

        try:
            devs = self.links.by_device()
            chosen = chosen_device()
            probe = silent(data)
            if chosen is not None:          # `passkey add`: that device only
                rounds = [[devs[chosen]] if chosen in devs else []]
            elif data[0] == GET_INFO:       # the same app everywhere
                rounds = [list(devs.values())[:1]]
            elif data[0] == GET_NEXT_ASSERTION:
                rounds = [[devs[self.last]] if self.last in devs else []]
            elif data[0] == GET_ASSERTION and not probe and self.holders & devs.keys():
                # Where the key is, so the others show no "No key" prompt;
                # the rest only if none of those has it after all.
                first = [l for d, l in devs.items() if d in self.holders]
                rounds = [first, [l for l in devs.values() if l not in first]]
            else:
                rounds = [list(devs.values())]
            deadline = time.monotonic() + 600   # the computer cancels sooner
            errors = []
            for targets in rounds:
                if not targets:
                    continue
                win, errs = self._fan_out(me, targets, data, deadline, probe)
                if win:
                    link, payload = win[0]
                    if data[0] == GET_ASSERTION:
                        self.last = link.device
                        if probe:
                            self.holders = {l.device for l, _ in win}
                    return answer(CBOR, payload)
                errors += errs
                if not errs or any(e[0] != NO_CREDENTIALS for e in errs):
                    break                   # refused, cancelled or gone: no next round
            final = next((e for e in errors if e[0] != NO_CREDENTIALS), errors[0] if errors else None)
            answer(CBOR, final or bytes([CTAP2_ERR_OTHER]))
        finally:
            with self.lock:
                if self.busy is me:
                    self.busy = None

    def _fan_out(self, me, targets, data, deadline, wait_all):
        """Asks every target at once. The first approval, or a refusal, ends
        the request and the others are withdrawn; wait_all (a silent probe)
        collects every answer. Returns ([(link, payload)] approvals, [errors])."""
        pending = []
        for l in targets:
            try:
                l.send(struct.pack(">BI", REQ, me.number) + data)
                pending.append(l)
            except OSError:
                pass
        with self.lock:
            me.pending = list(pending)
        wins, errors, done, beat = [], [], False, 0.0
        while pending and not done and time.monotonic() < deadline and self.busy is me:
            heard = False
            for l in list(pending):
                try:
                    r = l.responses.get_nowait()
                except queue.Empty:
                    continue
                heard = True
                if r is not None and r[0] != me.number:   # late answer to an abandoned request
                    continue
                pending.remove(l)
                if not r or not r[1]:       # connection lost, or an empty answer
                    errors.append(bytes([CTAP2_ERR_OTHER]))
                    continue
                if VERBOSE:
                    log(f"ctap {data[0]:#04x}{' probe' if wait_all else ''} -> {r[1][0]:#04x} ({l.name})")
                if r[1][0] == 0:
                    wins.append((l, r[1]))
                    done = not wait_all
                else:
                    errors.append(r[1])
                    done = r[1][0] == OPERATION_DENIED and not wait_all   # the user said no
                if done:
                    break
            if not heard:
                if time.monotonic() - beat >= 0.1 and self.busy is me:
                    self.reply(me.cid, KEEPALIVE, bytes([2]))    # waiting for the user
                    beat = time.monotonic()
                time.sleep(0.02)
        with self.lock:
            me.pending = []
        self._withdraw(me, pending)
        return wins, errors


# --- transports ---------------------------------------------------------------
class AdbError(Exception):
    pass


def adb_server_trusted():
    """The root daemon only talks to an adb server run by the configured user
    (or root). Anyone can listen on 127.0.0.1:5037 when adb is not running."""
    allowed = {0, os.geteuid()}
    if ADB_USER:
        try:
            allowed.add(pwd.getpwnam(ADB_USER).pw_uid)
        except KeyError:
            pass
    try:
        with open("/proc/net/tcp") as f:
            for line in f.readlines()[1:]:
                p = line.split()
                if p[1] in ("0100007F:13AD", "00000000:13AD") and p[3] == "0A":
                    return int(p[7]) in allowed
    except OSError:
        pass
    return False


def adb_peer_trusted(sock):
    """The server end of this very connection must belong to a trusted uid;
    closes the gap between adb_server_trusted() and connecting."""
    ip, port = sock.getsockname()
    ours = "%08X:%04X" % (struct.unpack("<I", socket.inet_aton(ip))[0], port)
    allowed = {0, os.geteuid()}
    if ADB_USER:
        try:
            allowed.add(pwd.getpwnam(ADB_USER).pw_uid)
        except KeyError:
            pass
    with open("/proc/net/tcp") as f:
        for line in f.readlines()[1:]:
            p = line.split()
            if p[1] == "0100007F:13AD" and p[2] == ours:
                return int(p[7]) in allowed
    return False


def adb_request(service, sock=None):
    """Talks to the adb server directly (port 5037): no processes, no log noise."""
    if sock is None:
        sock = socket.create_connection(("127.0.0.1", 5037), timeout=3)
        if not adb_peer_trusted(sock):
            sock.close()
            raise AdbError("untrusted adb server")
    sock.sendall(b"%04x" % len(service) + service.encode())
    if sock.recv(4) != b"OKAY":
        sock.close()
        raise AdbError(service)
    return sock


def adb_devices():
    with adb_request("host:devices") as s:
        data = b""
        while chunk := s.recv(4096):
            data += chunk
    text = data[4:].decode(errors="replace")
    return [l.split("\t")[0] for l in text.splitlines() if l.endswith("\tdevice")]


def adb_setting(serial, setting):
    """A device setting, such as "global device_name" (the name in Settings >
    About), or "" when it cannot be read."""
    out = b""
    try:
        with adb_request("host:transport:" + serial) as s:
            adb_request("shell:settings get " + setting, s)
            while chunk := s.recv(256):
                out += chunk
    except (OSError, AdbError):
        pass
    v = out.decode(errors="replace").strip()
    return "" if v == "null" else v


def adb_device_id(serial):
    """The device's Bluetooth address, the id its Bluetooth connection has too."""
    a = adb_setting(serial, "secure bluetooth_address").upper()
    return a if re.fullmatch(r"([0-9A-F]{2}:){5}[0-9A-F]{2}", a) else "usb:" + serial


def adb_start_server():
    # Only when none is running, and with the user's own adb key, so the
    # device does not ask "Allow USB debugging?" a second time.
    cmd = ["adb", "start-server"]
    if ADB_USER and os.geteuid() == 0:
        cmd = ["runuser", "-u", ADB_USER, "--", *cmd]
    subprocess.run(cmd, capture_output=True, timeout=20)


def adb_loop(links):
    """USB: connect to the app's socket on every device adb sees."""
    if not shutil.which("adb") or os.environ.get("PASSKEY_NO_USB") == "1":
        return
    retry, started = {}, 0.0
    while True:
        serials = []
        if adb_server_trusted():
            try:
                serials = adb_devices()
            except (OSError, AdbError):
                pass
        elif time.monotonic() - started > 60:
            started = time.monotonic()
            try:
                adb_start_server()
            except (OSError, subprocess.TimeoutExpired):
                pass
        have = links.names()
        for serial in serials:
            name = "usb:" + serial
            if name in have or retry.get(serial, 0) > time.monotonic():
                continue
            try:
                sock = adb_request("host:transport:" + serial)
                adb_request("localabstract:" + SOCKET, sock)
                # adb accepts even when the app is not running; ping first.
                sock.sendall(struct.pack(">IB", 1, PING))
                got = b""
                while len(got) < 5 and (chunk := sock.recv(5 - len(got))):
                    got += chunk
                if got == struct.pack(">IB", 1, PONG):
                    sock.settimeout(None)
                    links.add(Link(name, sock, prio=0, label=adb_setting(serial, "global device_name"),
                                   device=adb_device_id(serial)))
                    retry.pop(serial, None)
                    continue
                sock.close()
            except (OSError, AdbError):
                pass
            retry[serial] = time.monotonic() + 10
        time.sleep(3)


def keepalive_loop(links):
    """Bluetooth can drop silently; a connection that stops answering is let go."""
    while True:
        time.sleep(20)
        for l in links.all():
            if not l.ping(10):
                log("no answer:", l.name)
                l.close()


def bluetooth(links):
    """RFCOMM server on BlueZ; the paired device connects to this computer."""
    try:
        import dbus, dbus.service, dbus.mainloop.glib
        from gi.repository import GLib
    except ImportError:
        log("bluetooth: python-dbus / python-gobject missing, USB only")
        while True:
            time.sleep(3600)

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()

    def addr(device):
        return "bt:" + str(device).rsplit("dev_", 1)[-1].replace("_", ":")

    def alias(device):
        # BlueZ answers NewConnection asynchronously, so it can answer this.
        try:
            return str(bus.get_object("org.bluez", device).Get(
                "org.bluez.Device1", "Alias", dbus_interface=dbus.PROPERTIES_IFACE, timeout=2))
        except dbus.DBusException:
            return ""

    class Profile(dbus.service.Object):
        @dbus.service.method("org.bluez.Profile1", in_signature="", out_signature="")
        def Release(self):
            pass

        @dbus.service.method("org.bluez.Profile1", in_signature="oha{sv}", out_signature="")
        def NewConnection(self, device, fd, props):
            sock = socket.socket(fileno=fd.take())
            sock.setblocking(True)
            links.add(Link(addr(device), sock, prio=1, label=alias(device), device=addr(device)[3:]))

        @dbus.service.method("org.bluez.Profile1", in_signature="o", out_signature="")
        def RequestDisconnection(self, device):
            for l in links.all():
                if l.name == addr(device):
                    l.close()

    path = "/sn/mahir/passkey"
    Profile(bus, path)

    def register():
        try:
            dbus.Interface(bus.get_object("org.bluez", "/org/bluez"), "org.bluez.ProfileManager1") \
                .RegisterProfile(path, BT_UUID, {
                    "Name": "passkey", "Role": "server", "Channel": dbus.UInt16(BT_CHANNEL),
                    # BlueZ's generated record has a service class list Android
                    # rejects, so the record is given explicitly.
                    "ServiceRecord": SDP_RECORD,
                    "RequireAuthentication": True, "RequireAuthorization": False,
                    "AutoConnect": False})
            log("bluetooth: listening")
        except dbus.DBusException as e:
            if "AlreadyExists" not in str(e):
                log("bluetooth: not registered:", e)
                GLib.timeout_add_seconds(10, register)
        return False

    # The profile is lost when bluetoothd restarts; register again.
    bus.watch_name_owner("org.bluez", lambda owner: owner and GLib.idle_add(register))
    GLib.MainLoop().run()


def main():
    hid = None
    lock = threading.Lock()

    def changed():
        with lock:                     # decide and act as one step
            if links.any():
                uhid.create()
            else:
                hid.cancel()
                uhid.destroy()

    links = Links(changed)
    hid = Ctaphid(links)
    uhid = Uhid(hid.packet, hid.cancel)
    hid.uhid = uhid
    threading.Thread(target=adb_loop, args=(links,), daemon=True).start()
    threading.Thread(target=keepalive_loop, args=(links,), daemon=True).start()
    bluetooth(links)


if __name__ == "__main__":
    main()
