# Builds from this checkout: cd pc && makepkg -si
pkgname=passkey
pkgver=1.5.0
pkgrel=1
pkgdesc="Android device fingerprint as a FIDO2 security key: login, sudo, polkit, browsers"
arch=(x86_64 aarch64)
url="https://github.com/mahirsn/passkey"
license=(GPL-3.0-or-later)
depends=(pam pam-u2f libfido2 systemd)
optdepends=('android-tools: connect over USB'
            'bluez: connect over Bluetooth')
makedepends=(cargo rust)

build() {
    cargo build --manifest-path "$startdir/../Cargo.toml" --workspace --release --locked --target-dir "$srcdir/target"
}

check() {
    cargo test --manifest-path "$startdir/../Cargo.toml" --workspace --release --locked --target-dir "$srcdir/target"
}

package() {
    install -Dm755 "$srcdir/target/release/passkey" "$pkgdir/usr/bin/passkey"
    install -Dm755 "$srcdir/target/release/libpam_passkey.so" "$pkgdir/usr/lib/security/pam_passkey.so"
    install -Dm644 "$startdir/passkeyd.service" "$pkgdir/usr/lib/systemd/system/passkeyd.service"
}
