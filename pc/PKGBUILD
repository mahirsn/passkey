# Builds from this checkout: cd pc && makepkg -si
pkgname=passkey
pkgver=1.5.0
pkgrel=1
pkgdesc="Android device fingerprint as a FIDO2 security key: login, sudo, polkit, browsers"
arch=(x86_64 aarch64)
url="https://github.com/mahirsn/passkey"
license=(GPL-3.0-or-later)
depends=(pam pam-u2f libfido2 systemd)
optdepends=('android-tools: connect over USB'
            'bluez: connect over Bluetooth')
makedepends=(cargo)

_make() {
    make -C "$startdir/.." PREFIX=/usr CARGO_TARGET_DIR="$srcdir/target" "$@"
}

prepare() {
    # Crates are downloaded here, once; build and check work offline.
    cargo fetch --locked --manifest-path "$startdir/../Cargo.toml"
}

build() {
    _make CARGO_FLAGS=--frozen pc
}

check() {
    _make CARGO_FLAGS=--frozen test
}

package() {
    _make CARGO_FLAGS=--frozen DESTDIR="$pkgdir" install
}
